---
import { ChevronRight } from "lucide-react";
import { formatDate } from "@/lib/utils";

interface Post {
  id: string;
  data: {
    title: string;
    publishedAt: string;
    summary: string;
    author?: string;
    image?: string;
  };
}

interface Pagination {
  page: number;
  pageSize: number;
  totalPages: number;
  hasNextPage: boolean;
  hasPreviousPage: boolean;
}

interface Props {
  posts: Post[];
  totalPosts: number;
  pagination: Pagination;
}

const { posts, totalPosts, pagination } = Astro.props;
const pageHref = (page: number) =>
  page === 1 ? "/blog/" : `/blog/page/${page}/`;
---

<section id="blog" class="mx-auto w-full max-w-5xl px-5 pb-20 pt-12 sm:px-8 sm:pt-16 lg:px-10">
  <header class="blog-reveal mb-10 flex flex-col gap-5 border-b border-border pb-8 sm:flex-row sm:items-end sm:justify-between" style="--reveal-delay: 0.04s">
    <div>
      <p class="mb-3 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">
        <span class="h-px w-7 bg-primary"></span>
        Field notes
      </p>
      <h1 class="text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">Writing</h1>
      <p class="mt-3 max-w-xl text-base leading-7 text-muted-foreground">
        Notes on cloud infrastructure, software, and the work of learning.
      </p>
    </div>
    <p class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
      {String(totalPosts).padStart(2, "0")} {totalPosts === 1 ? "article" : "articles"}
    </p>
  </header>

  {posts.length > 0 ? (
    <>
      <div class="flex flex-col">
        {posts.map((post, index) => {
          const indexNumber = (pagination.page - 1) * pagination.pageSize + index + 1;
          return (
            <article
              class="blog-reveal border-b border-border py-7 first:pt-0 sm:py-9"
              style={`--reveal-delay: ${0.1 + index * 0.05}s`}
            >
              <a
                class="group grid gap-5 rounded-sm focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4 sm:grid-cols-[minmax(0,1fr)_220px] sm:items-center sm:gap-8"
                href={`/blog/${post.id}/`}
              >
                <div class="order-2 min-w-0 sm:order-1">
                  <div class="mb-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-muted-foreground">
                    <time datetime={post.data.publishedAt}>{formatDate(post.data.publishedAt)}</time>
                    {post.data.author && <span>{post.data.author}</span>}
                    <span class="ml-auto tabular-nums">{String(indexNumber).padStart(2, "0")}</span>
                  </div>
                  <h2 class="text-xl font-semibold leading-snug tracking-tight transition-colors group-hover:text-primary sm:text-2xl">
                    {post.data.title}
                    <ChevronRight
                      className="ml-2 inline-block size-4 -translate-x-1 text-muted-foreground opacity-0 transition-all duration-200 group-hover:translate-x-0 group-hover:opacity-100"
                      aria-hidden="true"
                    />
                  </h2>
                  <p class="mt-3 max-w-2xl text-sm leading-6 text-muted-foreground sm:text-base sm:leading-7">
                    {post.data.summary}
                  </p>
                  <span class="mt-4 inline-block text-xs font-medium text-foreground underline decoration-border underline-offset-4 transition-colors group-hover:decoration-primary">
                    Read article
                  </span>
                </div>
                {post.data.image && (
                  <div class="order-1 aspect-[16/10] overflow-hidden rounded-md bg-muted sm:order-2">
                    <img
                      src={post.data.image}
                      alt={post.data.title}
                      loading="lazy"
                      class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                  </div>
                )}
              </a>
            </article>
          );
        })}
      </div>

      {pagination.totalPages > 1 && (
        <nav
          aria-label="Blog pagination"
          class="blog-reveal mt-8 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"
          style={`--reveal-delay: ${0.15 + posts.length * 0.05}s`}
        >
          <div class="font-mono text-xs uppercase tracking-[0.08em] text-muted-foreground">
            Page {String(pagination.page).padStart(2, "0")} <span class="px-1 text-border">/</span> {String(pagination.totalPages).padStart(2, "0")}
          </div>
          <div class="flex gap-3">
            {pagination.hasPreviousPage ? (
              <a
                href={pageHref(pagination.page - 1)}
                rel="prev"
                class="inline-flex min-h-10 items-center justify-center rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              >
                Previous
              </a>
            ) : (
              <span aria-disabled="true" class="inline-flex min-h-10 cursor-not-allowed items-center justify-center rounded-md border border-border px-4 text-sm font-medium opacity-45">
                Previous
              </span>
            )}
            {pagination.hasNextPage ? (
              <a
                href={pageHref(pagination.page + 1)}
                rel="next"
                class="inline-flex min-h-10 items-center justify-center gap-2 rounded-md border border-border px-4 text-sm font-medium transition-colors hover:bg-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
              >
                Next <ChevronRight className="size-4" aria-hidden="true" />
              </a>
            ) : (
              <span aria-disabled="true" class="inline-flex min-h-10 cursor-not-allowed items-center justify-center rounded-md border border-border px-4 text-sm font-medium opacity-45">
                Next
              </span>
            )}
          </div>
        </nav>
      )}
    </>
  ) : (
    <div class="blog-reveal border-y border-border py-16 text-center">
      <p class="text-lg font-medium">No articles yet</p>
      <p class="mt-2 text-sm text-muted-foreground">New writing will appear here.</p>
    </div>
  )}
</section>

<style>
  @keyframes blog-reveal {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  .blog-reveal {
    animation: blog-reveal 0.4s ease-out both;
    animation-delay: var(--reveal-delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-reveal {
      animation: none;
    }
  }
</style>