---
import {
  ArrowDown,
  ArrowUpRight,
  Cloud,
} from "lucide-react";
import EducationSection from "@/components/section/education-section";
import ProjectsSection from "@/components/section/projects-section";
import WorkSection from "@/components/section/work-section";
import FlickeringGrid from "@/components/magicui/flickering-grid";
import { DATA } from "@/data/resume";

const sections = DATA.sections;
---

<main class="relative min-h-dvh overflow-hidden">
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 -z-20 bg-background"></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-112.5 w-187.5 -translate-x-1/2 rounded-full bg-blue-500/4.5 blur-[120px]"
  ></div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 -z-10 opacity-[0.02] bg-[linear-gradient(to_right,hsl(var(--foreground))_1px,transparent_1px),linear-gradient(to_bottom,hsl(var(--foreground))_1px,transparent_1px)] bg-size-[64px_64px] mask-[linear-gradient(to_bottom,black,transparent_60%)]"
  ></div>

  <section id="hero" class="relative scroll-mt-24 overflow-hidden">
    <div
      aria-hidden="true"
      class="pointer-events-none absolute -right-45 top-1/2 -z-10 size-125 -translate-y-1/2 rounded-full bg-blue-500/[0.035] blur-[120px]"
    ></div>

    <div class="mx-auto w-full max-w-5xl px-5 pb-14 pt-6 sm:px-8 sm:pb-16 sm:pt-10 lg:px-10 lg:pb-20 lg:pt-12">
      <div class="grid items-center gap-8 lg:grid-cols-[1fr_300px] lg:gap-12">
        <div class="relative z-20 max-w-2xl">
          <div
            class="home-reveal mb-4 inline-flex items-center gap-2 rounded-full border border-blue-500/15 bg-blue-500/4.5 px-3 py-1.5 text-[11px] font-medium uppercase tracking-[0.16em] text-blue-500 backdrop-blur-sm"
            style="--reveal-delay: 0.04s"
          >
            <Cloud className="size-3.5" />
            <span>{DATA.role}</span>
          </div>

          <h1
            class="home-reveal max-w-2xl text-[2.9rem] font-semibold leading-[0.95] tracking-[-0.045em] sm:text-5xl lg:text-[4.2rem] xl:text-[4.5rem]"
            style="--reveal-delay: 0.06s"
          >
            Hi, I'm {DATA.firstName}
          </h1>

          <h2
            class="home-reveal mt-4 max-w-xl text-xl font-medium leading-tight tracking-tight text-muted-foreground sm:text-2xl"
            style="--reveal-delay: 0.08s"
          >
            Building reliable infrastructure<span class="text-foreground"> with AWS.</span>
          </h2>

          <p
            class="home-reveal mt-5 max-w-xl text-[15px] leading-7 text-muted-foreground sm:text-base"
            style="--reveal-delay: 0.10s"
          >
            {DATA.description}
          </p>

          <div
            class="home-reveal mt-6 flex flex-wrap items-center gap-3"
            style="--reveal-delay: 0.14s"
          >
            <a
              href="#projects"
              class="group inline-flex h-10 items-center gap-2 rounded-lg bg-foreground px-4 text-sm font-medium text-background shadow-lg shadow-foreground/10 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl"
            >
              View My Work
              <ArrowUpRight className="size-4 transition-transform duration-200 group-hover:-translate-y-0.5 group-hover:translate-x-0.5" />
            </a>

            <a
              href={`mailto:${DATA.contact.email}`}
              class="inline-flex h-10 items-center rounded-lg border border-border bg-background/50 px-4 text-sm font-medium backdrop-blur-sm transition-colors hover:bg-muted"
            >
              Get in Touch
            </a>
          </div>
        </div>

        <div class="home-reveal relative hidden lg:block" style="--reveal-delay: 0.06s">
          <div class="relative mx-auto h-100 w-full max-w-[320px]">
            <div
              aria-hidden="true"
              class="absolute left-1/2 top-1/2 size-57.5 -translate-x-1/2 -translate-y-1/2 rounded-full bg-blue-500/6 blur-[80px]"
            ></div>
            <div
              aria-hidden="true"
              class="absolute left-1/2 top-[47%] size-72.5 -translate-x-1/2 -translate-y-1/2 rounded-full border border-border/40 bg-muted/10"
            ></div>
            <div
              aria-hidden="true"
              class="absolute left-1/2 top-[47%] size-80 -translate-x-1/2 -translate-y-1/2 rounded-full border border-dashed border-border/25"
            ></div>
            <img
              src={DATA.avatarUrl}
              alt={`${DATA.name} wizard illustration`}
              class="absolute -bottom-2.5 left-1/2 z-10 w-[115%] max-w-none -translate-x-1/2 object-contain drop-shadow-[0_25px_35px_rgba(0,0,0,0.3)]"
            />
            <div
              aria-hidden="true"
              class="absolute bottom-2 left-1/2 h-6 w-48 -translate-x-1/2 rounded-full bg-foreground/10 blur-2xl"
            ></div>
          </div>
        </div>
      </div>

      <a
        href="#about"
        class="home-reveal mx-auto mt-8 flex w-fit flex-col items-center gap-1.5 text-[11px] uppercase tracking-[0.15em] text-muted-foreground/40 transition-colors hover:text-muted-foreground"
        style="--reveal-delay: 0.20s"
      >
        <span>Scroll</span>
        <ArrowDown className="size-3.5 animate-bounce" />
      </a>
    </div>
  </section>

  <div class="mx-auto flex w-full max-w-5xl flex-col gap-24 px-5 pb-24 sm:px-8 lg:px-10">
    {sections.about.enabled && (
      <section id="about" class="scroll-mt-24" style={`order: ${sections.about.order}`}>
        <div class="flex flex-col gap-y-5">
          <div class="home-reveal" style="--reveal-delay: 0.12s">
            <div class="mb-2 flex items-center gap-3"><div class="h-px w-10 bg-border"></div></div>
            <h2 class="text-2xl font-semibold tracking-tight sm:text-[1.65rem]">{sections.about.heading}</h2>
          </div>
          <div class="home-reveal max-w-3xl" style="--reveal-delay: 0.16s">
            <div class="prose max-w-full text-pretty font-sans text-[18px] leading-7 text-muted-foreground dark:prose-invert">
              <p>{DATA.summary}</p>
            </div>
          </div>
        </div>
      </section>
    )}

    {sections.work.enabled && (
      <section id="work" class="scroll-mt-24" style={`order: ${sections.work.order}`}>
        <div class="flex flex-col gap-y-7">
          <div class="home-reveal" style="--reveal-delay: 0.20s">
            <div class="mb-2 flex items-center gap-3"><div class="h-px w-10 bg-border"></div></div>
            <h2 class="text-2xl font-semibold tracking-tight sm:text-[1.65rem]">{sections.work.heading}</h2>
          </div>
          <div class="home-reveal" style="--reveal-delay: 0.24s">
            <WorkSection client:load />
          </div>
        </div>
      </section>
    )}

    {sections.education.enabled && (
      <section id="education" class="scroll-mt-24" style={`order: ${sections.education.order}`}>
        <div class="flex flex-col gap-y-7">
          <div class="home-reveal" style="--reveal-delay: 0.28s">
            <div class="mb-2 flex items-center gap-3"><div class="h-px w-10 bg-border"></div></div>
            <h2 class="text-2xl font-semibold tracking-tight sm:text-[1.65rem]">{sections.education.heading}</h2>
            <p class="mt-1.5 max-w-2xl text-sm leading-6 text-muted-foreground">Academic background and verified professional credentials.</p>
          </div>
          <div class="home-reveal" style="--reveal-delay: 0.32s">
            <EducationSection />
          </div>
        </div>
      </section>
    )}

    {sections.skills.enabled && (
      <section id="skills" class="scroll-mt-24" style={`order: ${sections.skills.order}`}>
        <div class="flex flex-col gap-y-6">
          <div class="home-reveal" style="--reveal-delay: 0.36s">
            <div class="mb-2 flex items-center gap-3"><div class="h-px w-10 bg-border"></div></div>
            <h2 class="text-2xl font-semibold tracking-tight sm:text-[1.65rem]">{sections.skills.heading}</h2>
          </div>
          <div class="flex max-w-3xl flex-wrap gap-2">
            {DATA.skills.map((skill, index) => {
              const SkillIcon = skill.icon;
              return (
                <div
                  class="home-reveal group inline-flex h-9 items-center gap-2 rounded-lg border border-border/60 bg-background/60 px-3.5 backdrop-blur-sm transition-all duration-200 hover:border-foreground/20 hover:bg-muted/50"
                  style={`--reveal-delay: ${0.4 + index * 0.04}s`}
                >
                  {SkillIcon && <SkillIcon className="size-4 object-contain" />}
                  <span class="text-sm font-medium">{skill.name}</span>
                </div>
              );
            })}
          </div>
        </div>
      </section>
    )}

    {sections.projects.enabled && (
      <div style={`order: ${sections.projects.order}`}>
        <ProjectsSection />
      </div>
    )}

    {sections.contact.enabled && (
      <section id="contact" class="scroll-mt-24" style={`order: ${sections.contact.order}`}>
        <div class="relative rounded-xl border p-10">
          <div class="absolute -top-4 left-1/2 z-10 -translate-x-1/2 rounded-xl border bg-primary px-4 py-1">
            <span class="text-sm font-medium text-background">{sections.contact.label}</span>
          </div>
          <div class="absolute inset-x-0 top-0 h-1/2 overflow-hidden rounded-xl">
            <FlickeringGrid
              client:visible
              className="h-full w-full"
              squareSize={2}
              gridGap={2}
              style={{
                maskImage: "linear-gradient(to bottom, black, transparent)",
                WebkitMaskImage: "linear-gradient(to bottom, black, transparent)",
              }}
            />
          </div>
          <div class="home-reveal relative flex flex-col items-center gap-4 text-center" style="--reveal-delay: 0.56s">
            <h2 class="text-3xl font-bold tracking-tighter sm:text-5xl">{sections.contact.heading}</h2>
            <p class="mx-auto max-w-lg text-balance text-muted-foreground">{sections.contact.text}</p>
            <a
              href={`mailto:${DATA.contact.email}`}
              class="text-sm text-muted-foreground underline underline-offset-4 transition-colors hover:text-foreground"
            >
              {DATA.contact.email}
            </a>
          </div>
        </div>
      </section>
    )}
  </div>
</main>

<style is:global>
  @keyframes home-reveal {
    from {
      opacity: 0;
      filter: blur(6px);
      transform: translateY(-6px);
    }

    to {
      opacity: 1;
      filter: blur(0);
      transform: translateY(0);
    }
  }

  .home-reveal {
    animation: home-reveal 0.4s ease-out both;
    animation-delay: var(--reveal-delay, 0s);
  }

  @media (prefers-reduced-motion: reduce) {
    .home-reveal {
      animation: none;
    }
  }
</style>