---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { DATA } from "@/data/resume";
import { formatDate } from "@/lib/utils";
import { mdxComponents } from "@/mdx-components";
import { ChevronLeft, ChevronRight } from "lucide-react";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  const sortedPosts = [...posts].sort((a, b) => {
    if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
    return 1;
  });
  return sortedPosts.map((post, index) => ({
    params: { slug: post.id },
    props: {
      post,
      previousPost: index > 0 ? sortedPosts[index - 1] : null,
      nextPost: index < sortedPosts.length - 1 ? sortedPosts[index + 1] : null,
    },
  }));
}

const { post, previousPost, nextPost } = Astro.props;
const { title, publishedAt, updatedAt, author, summary, image } = post.data;
const slug = post.id;
const canonicalURL = new URL(`/blog/${slug}/`, DATA.url).href;

const { Content } = await render(post);

const articleImage = image ? new URL(image, DATA.url).href : undefined;
const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  datePublished: publishedAt,
  ...(updatedAt ? { dateModified: updatedAt } : {}),
  description: summary,
  ...(articleImage ? { image: articleImage } : {}),
  url: canonicalURL,
  ...(author ? { author: { "@type": "Person", name: author } } : {}),
}).replace(/</g, "\\u003c");
---

<Layout
  title={title}
  description={summary}
  image={image}
  canonicalURL={canonicalURL}
  ogType="article"
  publishedAt={publishedAt}
  updatedAt={updatedAt}
  author={author}
>
  <section id="blog" class="mx-auto w-full max-w-5xl px-5 pb-20 pt-8 sm:px-8 sm:pt-12 lg:px-10">
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <div class="mb-10">
      <a
        href="/blog/"
        class="group inline-flex items-center gap-2 text-sm text-muted-foreground transition-colors hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-4"
        aria-label="Back to Blog"
      >
        <ChevronLeft
          className="size-4 transition-transform group-hover:-translate-x-1"
        />
        All articles
      </a>
    </div>
    <header class="mx-auto max-w-3xl">
      <p class="mb-4 flex items-center gap-2 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">
        <span class="h-px w-7 bg-primary"></span>
        Article
      </p>
      <h1 class="text-balance text-3xl font-semibold leading-tight tracking-tight sm:text-4xl md:text-5xl">
        {title}
      </h1>
      
      <div class="mt-7 flex flex-wrap items-center gap-x-4 gap-y-2 border-y border-border py-4 text-sm text-muted-foreground">
        <time datetime={publishedAt}>{formatDate(publishedAt)}</time>
        {author && <span class="text-foreground">{author}</span>}
        {updatedAt && updatedAt !== publishedAt && (
          <span>Updated <time datetime={updatedAt}>{formatDate(updatedAt)}</time></span>
        )}
      </div>
    </header>

    {image && (
      <figure class="mx-auto my-9 w-full max-w-3xl overflow-hidden rounded-lg border border-border bg-muted sm:my-12">
        <img
          src={image}
          alt={title}
          fetchpriority="high"
          class="block aspect-[16/9] w-full object-cover"
        />
      </figure>
    )}

    <article
      class="article-content prose prose-base mx-auto max-w-3xl text-pretty font-sans leading-7 text-muted-foreground dark:prose-invert sm:prose-lg sm:leading-8"
    >
      <Content components={mdxComponents} />
    </article>

    <nav aria-label="More articles" class="mx-auto mt-16 max-w-3xl border-t border-border pt-8">
      <p class="mb-5 font-mono text-xs uppercase tracking-[0.12em] text-muted-foreground">Continue reading</p>
      <div class="grid gap-3 sm:grid-cols-2">
        {
          previousPost ? (
            <a
              href={`/blog/${previousPost.id}/`}
              rel="prev"
              class="group flex min-h-24 flex-col justify-between gap-3 rounded-md border border-border p-4 transition-colors hover:bg-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              <span class="flex items-center gap-1 text-xs text-muted-foreground">
                <ChevronLeft className="size-3" />
                Newer article
              </span>
              <span class="text-sm font-medium leading-5 text-foreground transition-colors group-hover:text-primary">
                {previousPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )
        }

        {
          nextPost ? (
            <a
              href={`/blog/${nextPost.id}/`}
              rel="next"
              class="group flex min-h-24 flex-col justify-between gap-3 rounded-md border border-border p-4 text-right transition-colors hover:bg-accent/60 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2"
            >
              <span class="flex items-center justify-end gap-1 text-xs text-muted-foreground">
                Older article
                <ChevronRight className="size-3" />
              </span>
              <span class="text-sm font-medium leading-5 text-foreground transition-colors group-hover:text-primary">
                {nextPost.data.title}
              </span>
            </a>
          ) : (
            <div class="hidden sm:block" />
          )
        }
      </div>
    </nav>
    <style>
      .article-content :global(h2) {
        margin-top: 2.5em;
      }

      .article-content :global(h3) {
        margin-top: 2em;
      }

      .article-content :global(p),
      .article-content :global(ul),
      .article-content :global(ol) {
        margin-top: 1.25em;
        margin-bottom: 1.25em;
      }

      .article-content :global(li + li) {
        margin-top: 0.45em;
      }

      .article-content :global(pre) {
        max-width: 100%;
      }

      .article-content :global(img),
      .article-content :global(video) {
        border-radius: 0.5rem;
      }
    </style>
  </section>

  <script is:inline>
    document.addEventListener("click", async (event) => {
      if (!(event.target instanceof Element)) return;

      const button = event.target.closest("[data-copy-code]");
      if (!(button instanceof HTMLButtonElement)) return;

      const block = button.closest("[data-code-block]");
      const code = block?.querySelector("pre code")?.textContent ?? "";
      const status = block?.querySelector("[data-copy-status]");
      let copied = false;

      try {
        if (navigator.clipboard?.writeText) {
          await navigator.clipboard.writeText(code);
          copied = true;
        }
      } catch {
        copied = false;
      }

      if (!copied) {
        const textarea = document.createElement("textarea");
        textarea.value = code;
        textarea.setAttribute("readonly", "");
        textarea.style.position = "fixed";
        textarea.style.opacity = "0";
        document.body.append(textarea);
        textarea.select();
        try {
          copied = document.execCommand("copy");
        } catch {
          copied = false;
        }
        textarea.remove();
      }

      const message = copied ? "Copied" : "Copy failed";
      button.setAttribute("aria-label", message);
      button.setAttribute("title", message);
      if (status) status.textContent = message;
      button.querySelector("[data-copy-icon]")?.classList.toggle("hidden", copied);
      button.querySelector("[data-copied-icon]")?.classList.toggle("hidden", !copied);

      window.setTimeout(() => {
        button.setAttribute("aria-label", "Copy code");
        button.setAttribute("title", "Copy code");
        if (status) status.textContent = "";
        button.querySelector("[data-copy-icon]")?.classList.remove("hidden");
        button.querySelector("[data-copied-icon]")?.classList.add("hidden");
      }, 2000);
    });
  </script>
</Layout>
