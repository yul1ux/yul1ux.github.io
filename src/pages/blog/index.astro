---
import Layout from "@/layouts/Layout.astro";
import BlogList from "@/components/BlogList.astro";
import { getBlogPages } from "@/lib/blog-pagination";

const [{ items: posts, pagination, totalPosts }] = await getBlogPages();
---

<Layout title="Blog" description="Thoughts on software development, life, and more.">
  <section id="blog" class="mx-auto w-full max-w-5xl px-5 sm:px-8 lg:px-10">
    <BlogList
      posts={posts}
      totalPosts={totalPosts}
      pagination={pagination}
    />
  </section>
</Layout>
